            "body": {
              "mode": "raw",
              "raw": "{\n  \"pregnancy_profile_id\": \"{{pregnancy_profile_id}}\",\n  \"symptom_checkin_id\": \"{{symptom_checkin_id}}\",\n  \"answers\": {\n    \"bengkak_kaki\": false,\n    \"sakit_kepala\": \"tidak_ada\",\n    \"pandangan_kabur\": false,\n    \"mual_muntah\": \"ringan\"\n  },\n  \"latest_anc\": {\n    \"systolic\": 115,\n    \"diastolic\": 75,\n    \"protein_urine\": \"negatif\"\n  },\n  \"has_preeclampsia_history\": false,\n  \"bidan_phone\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/triage/analyze",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "triage", "analyze"]
            },
            "description": "Skenario aman — tensi normal, protein urine negatif, gejala minimal.\n\nExpected:\n- risk_badge: \"hijau\"\n- aggregate_score: rendah (<30)\n- bidan_review_required: false\n- alert_delivery_status: \"not_triggered\"\n- recommendation_text: tone positif dari LLM\n\nLihat rule di ai-service/app/models/triage_rules.py — THRESHOLDS + WEIGHTS."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('risk_badge = hijau', () => pm.expect(json.risk_badge).to.eql('hijau'));",
                  "pm.test('aggregate_score < 30', () => pm.expect(json.aggregate_score).to.be.below(30));",
                  "pm.test('alert NOT triggered', () => pm.expect(json.alert_delivery_status).to.eql('not_triggered'));",
                  "pm.test('bidan_review_required = false', () => pm.expect(json.bidan_review_required).to.eql(false));",
                  "pm.test('screening_not_diagnosis = true', () => pm.expect(json.screening_not_diagnosis).to.eql(true));",
