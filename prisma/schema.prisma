generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ibu_hamil
  bidan
  kader
  admin
  dokter
}

enum PregnancyStatus {
  hamil
  nifas
  selesai
}

enum PregnancyOutcome {
  persalinan
  keguguran
}

enum RiskBadge {
  hijau
  kuning
  merah
}

enum BidanTriageAction {
  acknowledge
  override_badge
  dismiss
}

enum AncSource {
  self
  nakes
  kader_offline
}

enum CheckinType {
  pregnancy
}

enum BleedingLevel {
  normal
  banyak
  sangat_banyak
}

enum WoundCondition {
  baik
  bau
  bengkak_merah
}

enum MoodFlag {
  baik
  kadang_sedih
  sering_sedih
}

enum NotificationChannel {
  wa_patient
  wa_bidan
  wa_family
  in_app
}

enum NotificationStatus {
  pending
  sent
  failed
  no_device_fallback
}

enum ReminderType {
  anc_checkup
  postpartum_checkin
}

enum ReminderStatus {
  active
  paused
  done
}

enum NutritionActivityLogStatus {
  processed
  low_confidence
  unmatched_sender
  failed
}

enum NutritionMealPeriod {
  breakfast
  lunch
  dinner
  snack
  mixed
  unspecified
}

enum NotifyOn {
  merah_only
  semua_perubahan
}

enum SyncPayloadType {
  anc_record
  symptom_checkin
}

enum SyncStatus {
  pending
  processed
  failed
}

enum SymptomSource {
  self
  kader_offline
}

enum ChatSenderType {
  user
  ai
}

enum SupportSessionStatus {
  open
  closed
}

enum DayOfWeek {
  senin
  selasa
  rabu
  kamis
  jumat
  sabtu
  minggu
}

enum ConsultationStatus {
  pending_payment
  scheduled
  ongoing
  completed
  cancelled
  expired
}

enum PaymentStatus {
  pending
  paid
  expired
  failed
  refunded
}

enum ConsultationSenderType {
  patient
  doctor
}

enum EducationTrimester {
  trimester_1
  trimester_2
  trimester_3
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  role          UserRole
  full_name     String
  phone_number  String   @unique
  email         String?
  password_hash String
  is_active     Boolean  @default(true)
  puskesmas_id  String?  @db.Uuid
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  puskesmas          Puskesmas?         @relation(fields: [puskesmas_id], references: [id])
  pregnancy_profiles PregnancyProfile[]
  anc_records        AncRecord[]        @relation("RecordedBy")
  doctor             Doctor?
  consultation_messages ConsultationMessage[]
  triage_audits        TriageBidanAudit[]
  refresh_sessions     RefreshSession[]
  submitted_sync_items SyncQueue[]        @relation("SyncSubmittedBy")

  @@index([puskesmas_id])
  @@map("users")
}

model RefreshSession {
  id                 String    @id @default(uuid()) @db.Uuid
  user_id            String    @db.Uuid
  family_id          String    @db.Uuid
  token_hash         String    @unique @db.VarChar(64)
  expires_at         DateTime
  revoked_at         DateTime?
  replaced_by_id     String?   @unique @db.Uuid
  created_at         DateTime  @default(now())

  user        User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  replaced_by RefreshSession? @relation("RefreshRotation", fields: [replaced_by_id], references: [id])
  replaces    RefreshSession? @relation("RefreshRotation")

  @@index([user_id, family_id])
  @@index([expires_at])
  @@map("refresh_sessions")
}

model PregnancyProfile {
  id                       String            @id @default(uuid()) @db.Uuid
  user_id                  String            @db.Uuid
  hpht                     DateTime          @db.Date
  hpl                      DateTime          @db.Date
  gravida                  Int
  existing_conditions      Json?             @default("[]")
  status                   PregnancyStatus   @default(hamil)
  pregnancy_outcome        PregnancyOutcome?
  ended_at                 DateTime?
  nifas_start_date         DateTime?         @db.Date
  had_preeclampsia_history Boolean           @default(false)
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt

  user             User              @relation(fields: [user_id], references: [id])
  anc_records      AncRecord[]
  symptom_checkins SymptomCheckin[]
  risk_assessments RiskAssessment[]
  postpartum_logs  PostpartumLog[]
  family_circles   FamilyCircle[]
  notifications    NotificationLog[]
  reminders        Reminder[]
  support_sessions SupportSession[]
  consultations    Consultation[]
  chat_messages    ChatMessage[]
  nutrition_activity_logs NutritionActivityLog[]
  nutrition_daily_logs NutritionDailyLog[]
  nutrition_prompt_window NutritionPromptWindow?

  @@index([user_id])
  @@index([status])
  @@map("pregnancy_profiles")
}

model NutritionActivityLog {
  id                     String                     @id @default(uuid()) @db.Uuid
  provider_message_id    String?                    @unique @db.VarChar(64)
  pregnancy_profile_id   String?                    @db.Uuid
  nutrition_daily_log_id String?                    @db.Uuid
  meal_period            NutritionMealPeriod        @default(unspecified)
  raw_message            String
  sender_phone           String                     @db.VarChar(32)
  sender_matched         Boolean
  parsed_calories        Decimal?                   @db.Decimal(6, 2)
  parsed_iron_mg         Decimal?                   @db.Decimal(6, 2)
  parsed_activity        String?
  parsed_items           Json?                      @default("[]")
  nutrition_per_item     Json?                      @default("[]")
  insight_text           String?
  confidence_score       Decimal?                   @db.Decimal(3, 2)
  status                 NutritionActivityLogStatus
  created_at             DateTime                   @default(now())

  pregnancy_profile PregnancyProfile? @relation(fields: [pregnancy_profile_id], references: [id], onDelete: SetNull)
  nutrition_daily_log NutritionDailyLog? @relation(fields: [nutrition_daily_log_id], references: [id], onDelete: SetNull)

  @@index([pregnancy_profile_id, created_at])
  @@index([nutrition_daily_log_id, created_at])
  @@index([sender_phone, created_at])
  @@map("nutrition_activity_logs")
}

model NutritionDailyLog {
  id                   String   @id @default(uuid()) @db.Uuid
  pregnancy_profile_id String   @db.Uuid
  log_date             DateTime @db.Date
  timezone             String   @default("Asia/Jakarta") @db.VarChar(64)
  total_calories       Decimal  @default(0) @db.Decimal(8, 2)
  total_iron_mg        Decimal  @default(0) @db.Decimal(8, 2)
  total_protein_g      Decimal  @default(0) @db.Decimal(8, 2)
  total_calcium_mg     Decimal  @default(0) @db.Decimal(10, 2)
  entry_count          Int      @default(0)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  pregnancy_profile PregnancyProfile @relation(fields: [pregnancy_profile_id], references: [id], onDelete: Cascade)
  entries NutritionActivityLog[]

  @@unique([pregnancy_profile_id, log_date])
  @@index([pregnancy_profile_id, log_date])
  @@map("nutrition_daily_logs")
}

model NutritionPromptWindow {
  id                     String   @id @default(uuid()) @db.Uuid
  pregnancy_profile_id   String   @unique @db.Uuid
  last_prompt_sent_at    DateTime
  window_closes_at       DateTime

  pregnancy_profile PregnancyProfile @relation(fields: [pregnancy_profile_id], references: [id], onDelete: Cascade)

  @@index([window_closes_at])
  @@map("nutrition_prompt_windows")
}

model AncRecord {
  id                   String    @id @default(uuid()) @db.Uuid
  pregnancy_profile_id String    @db.Uuid
  recorded_by_user_id  String    @db.Uuid
  source               AncSource
  systolic             Int?
  diastolic            Int?
  weight_kg            Decimal?  @db.Decimal(5, 2)
  fundal_height_cm     Decimal?  @db.Decimal(5, 2)
  protein_urine        String?
  platelet_count       Decimal?  @db.Decimal(10, 2)
  recorded_at          DateTime  @default(now())
  client_uuid          String?   @unique @db.Uuid
  created_at           DateTime  @default(now())

  pregnancy_profile PregnancyProfile @relation(fields: [pregnancy_profile_id], references: [id])
  recorded_by       User             @relation("RecordedBy", fields: [recorded_by_user_id], references: [id])

  @@index([pregnancy_profile_id, recorded_at])
  @@map("anc_records")
}

model SymptomCheckin {
  id                    String        @id @default(uuid()) @db.Uuid
  pregnancy_profile_id  String        @db.Uuid
  checkin_type          CheckinType
  answers               Json
  conjunctiva_image_url String?
  source                SymptomSource
  client_uuid           String?       @unique @db.Uuid
  created_at            DateTime      @default(now())

  pregnancy_profile PregnancyProfile @relation(fields: [pregnancy_profile_id], references: [id])
  risk_assessments  RiskAssessment[]

  @@map("symptom_checkins")
}

model RiskAssessment {
  id                       String    @id @default(uuid()) @db.Uuid
  pregnancy_profile_id     String    @db.Uuid
  symptom_checkin_id       String?   @unique @db.Uuid
  triage_score             Decimal   @db.Decimal(5, 2)
  anemia_probability       Decimal?  @db.Decimal(5, 4)
  preeclampsia_probability Decimal?  @db.Decimal(5, 4)
  aggregate_score          Decimal   @db.Decimal(5, 2)
  risk_badge               RiskBadge
  risk_factors             Json
  recommendation_text      String
  contract_version         String?
  model_status             String?
  model_version            String?
  missing_features         Json?     @default("[]")
  disclaimer               String?
  alert_delivery_status    String?
  anemia_is_mock           Boolean   @default(false)
  bidan_review_required    Boolean   @default(false)
  screening_not_diagnosis  Boolean   @default(true)
  evaluated_at             DateTime?
  created_at               DateTime  @default(now())

  pregnancy_profile PregnancyProfile @relation(fields: [pregnancy_profile_id], references: [id])
  symptom_checkin   SymptomCheckin?  @relation(fields: [symptom_checkin_id], references: [id])
  bidan_audits      TriageBidanAudit[]

  @@index([pregnancy_profile_id, created_at])
  @@index([risk_badge])
  @@map("risk_assessments")
}

model TriageBidanAudit {
  id                 String             @id @default(uuid()) @db.Uuid
  risk_assessment_id String             @db.Uuid
  bidan_id           String             @db.Uuid
  action             BidanTriageAction
  previous_risk_badge RiskBadge
  new_risk_badge     RiskBadge?
  rationale          String?
  ai_response         Json
  request_id          String?
  created_at          DateTime           @default(now())

  risk_assessment RiskAssessment @relation(fields: [risk_assessment_id], references: [id], onDelete: Restrict)
  bidan           User           @relation(fields: [bidan_id], references: [id], onDelete: Restrict)

  @@index([risk_assessment_id, created_at])
  @@index([bidan_id, created_at])
  @@map("triage_bidan_audits")
}

model PostpartumLog {
  id                   String         @id @default(uuid()) @db.Uuid
  pregnancy_profile_id String         @db.Uuid
  day_number           Int
  bleeding_level       BleedingLevel
  fever                Boolean
  wound_condition      WoundCondition
  headache_severe      Boolean
  mood_flag            MoodFlag
  red_flag_triggered   Boolean        @default(false)
  evaluation_reason    String?
  mental_health_flag   Boolean?
  evaluated_at         DateTime?
  client_uuid          String?        @unique @db.Uuid
  created_at           DateTime       @default(now())

  pregnancy_profile PregnancyProfile @relation(fields: [pregnancy_profile_id], references: [id])

  @@index([pregnancy_profile_id, day_number])
  @@index([pregnancy_profile_id, created_at])
  @@map("postpartum_logs")
}

model FamilyCircle {
  id                   String   @id @default(uuid()) @db.Uuid
  pregnancy_profile_id String   @db.Uuid
  contact_name         String
  contact_phone        String
  relation             String
  notify_on            NotifyOn
  created_at           DateTime @default(now())

  pregnancy_profile PregnancyProfile @relation(fields: [pregnancy_profile_id], references: [id])

  @@index([pregnancy_profile_id])
  @@map("family_circle")
}

model Puskesmas {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  latitude      Decimal @db.Decimal(10, 7)
  longitude     Decimal @db.Decimal(10, 7)
  wilayah_kerja String

  users User[]

  @@map("puskesmas")
}

model NotificationLog {
  id                   String              @id @default(uuid()) @db.Uuid
  pregnancy_profile_id String              @db.Uuid
  channel              NotificationChannel
  message              String
  status               NotificationStatus  @default(pending)
  sent_at              DateTime?
  created_at           DateTime            @default(now())

  pregnancy_profile PregnancyProfile @relation(fields: [pregnancy_profile_id], references: [id])

  @@index([pregnancy_profile_id, created_at])
  @@map("notifications_log")
}

model Reminder {
  id                   String         @id @default(uuid()) @db.Uuid
  pregnancy_profile_id String         @db.Uuid
  reminder_type        ReminderType
  cadence_days         Int
  next_trigger_at      DateTime
  last_sent_at         DateTime?
  status               ReminderStatus @default(active)

  pregnancy_profile PregnancyProfile @relation(fields: [pregnancy_profile_id], references: [id])

  @@unique([pregnancy_profile_id, reminder_type])
  @@index([next_trigger_at])
  @@map("reminders")
}

model SyncQueue {
  id                String          @id @default(uuid()) @db.Uuid
  device_uuid       String
  payload_type      SyncPayloadType
  payload           Json
  client_created_at DateTime
  synced_at         DateTime?
  status            SyncStatus      @default(pending)
  client_uuid       String          @unique @db.Uuid
  submitted_by_id   String          @db.Uuid
  submitted_by      User            @relation("SyncSubmittedBy", fields: [submitted_by_id], references: [id], onDelete: Cascade)

  @@index([device_uuid])
  @@index([submitted_by_id, device_uuid])
  @@map("sync_queue")
}

model SupportSession {
  id                   String               @id @default(uuid()) @db.Uuid
  pregnancy_profile_id String             @db.Uuid
  status               SupportSessionStatus @default(open)
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  pregnancy_profile PregnancyProfile @relation(fields: [pregnancy_profile_id], references: [id])

  @@index([pregnancy_profile_id, created_at])
  @@map("support_sessions")
}

model Doctor {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @unique @db.Uuid
  specialization String
  str_number     String?
  price          Decimal  @db.Decimal(10, 2)
  bio            String?
  photo_key      String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user          User             @relation(fields: [user_id], references: [id])
  schedules     DoctorSchedule[]
  consultations Consultation[]

  @@map("doctors")
}

model DoctorSchedule {
  id          String    @id @default(uuid()) @db.Uuid
  doctor_id   String    @db.Uuid
  day_of_week DayOfWeek
  start_time  String
  end_time    String

  doctor Doctor @relation(fields: [doctor_id], references: [id], onDelete: Cascade)

  @@index([doctor_id, day_of_week])
  @@map("doctor_schedules")
}

model Consultation {
  id                     String             @id @default(uuid()) @db.Uuid
  pregnancy_profile_id   String             @db.Uuid
  doctor_id              String             @db.Uuid
  scheduled_at           DateTime
  topic                  String
  complaint              String
  duration_minutes       Int                @default(30)
  price_snapshot         Decimal            @db.Decimal(10, 2)
  platform_fee           Decimal            @db.Decimal(10, 2)
  status                 ConsultationStatus @default(pending_payment)
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  pregnancy_profile PregnancyProfile     @relation(fields: [pregnancy_profile_id], references: [id])
  doctor             Doctor               @relation(fields: [doctor_id], references: [id])
  payment            Payment?
  messages           ConsultationMessage[]

  @@index([pregnancy_profile_id, created_at])
  @@index([doctor_id, scheduled_at])
  @@index([status, created_at])
  @@map("consultations")
}

model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  consultation_id     String        @unique @db.Uuid
  xendit_invoice_id   String        @unique
  amount              Decimal       @db.Decimal(10, 2)
  payment_url         String?
  expires_at          DateTime?
  status              PaymentStatus @default(pending)
  paid_at             DateTime?
  xendit_payload      Json?
  created_at          DateTime      @default(now())

  consultation Consultation @relation(fields: [consultation_id], references: [id])

  @@index([status, created_at])

  @@map("payments")
}

model ConsultationMessage {
  id               String                 @id @default(uuid()) @db.Uuid
  consultation_id  String                 @db.Uuid
  sender_type       ConsultationSenderType
  sender_user_id    String                 @db.Uuid
  message           String
  created_at        DateTime               @default(now())

  consultation Consultation @relation(fields: [consultation_id], references: [id])
  sender       User         @relation(fields: [sender_user_id], references: [id])

  @@index([consultation_id, created_at])
  @@map("consultation_messages")
}

model ChatMessage {
  id                   String         @id @default(uuid()) @db.Uuid
  pregnancy_profile_id String         @db.Uuid
  sender_type          ChatSenderType
  message              String
  reply_to_message_id  String?        @unique @db.Uuid
  disclaimer_included  Boolean?
  created_at           DateTime       @default(now())

  pregnancy_profile PregnancyProfile @relation(fields: [pregnancy_profile_id], references: [id])
  reply_to_message  ChatMessage?     @relation("ChatReply", fields: [reply_to_message_id], references: [id], onDelete: Restrict)
  reply             ChatMessage?     @relation("ChatReply")

  @@index([pregnancy_profile_id, created_at])
  @@map("chat_messages")
}

model EducationArticle {
  id          String              @id @default(uuid()) @db.Uuid
  title       String
  slug        String              @unique
  summary     String
  content     String
  trimester   EducationTrimester?
  category    String
  source_name String
  source_url  String
  reviewer    String
  published   Boolean             @default(false)
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt

  @@index([published, trimester, category])
  @@index([published, created_at])
  @@map("education_articles")
}
