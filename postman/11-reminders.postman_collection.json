        {
          "name": "GET /reminders — admin menemukan reminder postpartum",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result.data).to.be.an('array').and.not.empty;",
                  "const reminder = result.data.find((item) => item.reminder_type === 'postpartum_checkin');",
                  "pm.expect(reminder).to.exist;",
                  "pm.collectionVariables.set('postpartum_reminder_id', reminder.id);"
                ]
              }
            }
          ],
          "request": {
