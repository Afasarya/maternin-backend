                  "const result = pm.response.json().data;",
                  "pm.expect(result.data).to.be.an('array');",
                  "result.data.forEach((reminder) => pm.expect(reminder.status).to.eql('active'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
