  "item": [
    {
      "name": "Read",
      "item": [
        {
          "name": "GET /reminders — list reminder ANC",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result.data).to.be.an('array');",
                  "pm.expect(result.total).to.be.a('number');",
                  "pm.expect(result.data.length).to.be.at.most(20);",
                  "result.data.forEach((reminder) => {",
                  "  pm.expect(reminder.pregnancy_profile_id).to.eql(pm.collectionVariables.get('pregnancy_profile_id'));",
                  "  pm.expect(reminder.reminder_type).to.eql('anc_checkup');",
                  "});",
                  "if (result.data.length > 0) pm.collectionVariables.set('anc_reminder_id', result.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_ibu}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/reminders?pregnancy_profile_id={{pregnancy_profile_id}}&reminder_type=anc_checkup&limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["reminders"],
              "query": [
                {
                  "key": "pregnancy_profile_id",
                  "value": "{{pregnancy_profile_id}}"
                },
                {
                  "key": "reminder_type",
                  "value": "anc_checkup"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
