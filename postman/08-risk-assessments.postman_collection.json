                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pregnancy_profile_id\": \"{{pregnancy_profile_id}}\",\n  \"symptom_checkin_id\": null,\n  \"triage_score\": 15,\n  \"anemia_probability\": 0.08,\n  \"preeclampsia_probability\": 0.04,\n  \"aggregate_score\": 12.5,\n  \"risk_badge\": \"hijau\",\n  \"risk_factors\": [],\n  \"recommendation_text\": \"Lanjutkan pemeriksaan rutin.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/internal/risk-assessments",
              "host": ["{{base_url}}"],
              "path": ["internal", "risk-assessments"]
            },
            "description": "Membuat assessment hijau. Cadence reminder ANC aktif menjadi 14 hari. Menjadi data latest setelah callback."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const assessment = pm.response.json().data;",
                  "pm.expect(assessment.risk_badge).to.eql('hijau');",
                  "pm.collectionVariables.set('risk_assessment_id', assessment.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Public Read",
      "item": [
        {
          "name": "GET /pregnancy-profiles/:id/risk-assessments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_bidan}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pregnancy-profiles/{{pregnancy_profile_id}}/risk-assessments?limit=10&offset=0",
              "host": ["{{base_url}}"],
              "path": [
                "pregnancy-profiles",
                "{{pregnancy_profile_id}}",
                "risk-assessments"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result.data).to.be.an('array');",
                  "pm.expect(result.total).to.be.a('number');",
                  "pm.expect(result.data.length).to.be.at.most(10);",
                  "for (let i = 1; i < result.data.length; i++) {",
                  "  pm.expect(new Date(result.data[i - 1].created_at).getTime()).to.be.at.least(new Date(result.data[i].created_at).getTime());",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /risk-assessments/:id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/risk-assessments/{{risk_assessment_id}}",
              "host": ["{{base_url}}"],
              "path": ["risk-assessments", "{{risk_assessment_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const assessment = pm.response.json().data;",
                  "pm.expect(assessment.id).to.eql(pm.collectionVariables.get('risk_assessment_id'));",
                  "pm.expect(assessment.pregnancy_profile_id).to.eql(pm.collectionVariables.get('pregnancy_profile_id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /risk-assessments/latest",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_ibu}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/risk-assessments/latest?pregnancy_profile_id={{pregnancy_profile_id}}",
              "host": ["{{base_url}}"],
              "path": ["risk-assessments", "latest"],
              "query": [
                {
                  "key": "pregnancy_profile_id",
                  "value": "{{pregnancy_profile_id}}"
                }
              ]
            },
            "description": "Jalankan setelah callback hijau. Hasil harus data terbaru, membuktikan cache latest lama telah diinvalidasi. Panggilan berikutnya memakai cache TTL 10 menit."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
