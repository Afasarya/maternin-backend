        {
          "name": "POST /family-circle — tambah kontak suami",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const contact = pm.response.json().data;",
                  "pm.expect(contact.pregnancy_profile_id).to.eql(pm.collectionVariables.get('pregnancy_profile_id'));",
                  "pm.expect(contact.contact_name).to.eql('Budi Santoso');",
                  "pm.expect(contact.notify_on).to.eql('semua_perubahan');",
                  "pm.collectionVariables.set('family_circle_id', contact.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_ibu}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pregnancy_profile_id\": \"{{pregnancy_profile_id}}\",\n  \"contact_name\": \"Budi Santoso\",\n  \"contact_phone\": \"+628123456789\",\n  \"relation\": \"suami\",\n  \"notify_on\": \"semua_perubahan\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/family-circle",
              "host": ["{{base_url}}"],
              "path": ["family-circle"]
            }
          }
        },
