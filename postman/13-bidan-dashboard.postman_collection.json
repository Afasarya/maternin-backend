  "item": [
    {
      "name": "Patients",
      "item": [
        {
          "name": "GET /bidan/patients — default sorted by risk",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result.data).to.be.an('array');",
                  "pm.expect(result.total).to.be.a('number');",
                  "pm.expect(result.limit).to.eql(20);",
                  "pm.expect(result.offset).to.eql(0);",
                  "pm.expect(result.data.length).to.be.at.most(20);",
                  "pm.collectionVariables.set('bidan_patient_total', String(result.total));",
                  "const ranks = { merah: 0, kuning: 1, hijau: 2, null: 3 };",
                  "const actualRanks = result.data.map((patient) => ranks[String(patient.latest_risk_badge)]);",
                  "pm.test('Pasien globally sorted merah, kuning, hijau, lalu belum dinilai', () => pm.expect(actualRanks).to.eql([...actualRanks].sort((a, b) => a - b)));",
                  "pm.test('Semua field dashboard tersedia', () => result.data.forEach((patient) => {",
                  "  pm.expect(patient).to.have.keys('pregnancy_profile_id', 'patient_name', 'phone_number', 'hpl', 'gestational_week', 'latest_risk_badge', 'latest_aggregate_score', 'last_checkin_date', 'risk_factors');",
                  "  pm.expect(patient.risk_factors).to.be.an('array');",
                  "}));",
                  "const first = result.data[0];",
                  "if (first) pm.collectionVariables.set('pregnancy_profile_id', first.pregnancy_profile_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_bidan}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bidan/patients",
              "host": ["{{base_url}}"],
              "path": ["bidan", "patients"]
            }
          }
        },
        {
          "name": "GET /bidan/patients — filter merah",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().data;",
                  "pm.test('Hanya latest badge merah', () => {",
                  "  pm.expect(result.data).to.be.an('array').and.not.empty;",
                  "  result.data.forEach((patient) => pm.expect(patient.latest_risk_badge).to.eql('merah'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_bidan}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bidan/patients?risk_badge=merah",
              "host": ["{{base_url}}"],
              "path": ["bidan", "patients"],
              "query": [
                {
                  "key": "risk_badge",
                  "value": "merah"
                }
              ]
            }
          }
        },
        {
          "name": "GET /bidan/patients — search Siti",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().data;",
                  "pm.test('Nama pasien sesuai pencarian case-insensitive', () => {",
                  "  pm.expect(result.data).to.be.an('array').and.not.empty;",
                  "  result.data.forEach((patient) => pm.expect(patient.patient_name.toLowerCase()).to.include('siti'));",
                  "});"
                ]
              }
            }
