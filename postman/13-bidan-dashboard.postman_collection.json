                  "const result = pm.response.json().data;",
                  "const expectedPandanaranProfiles = ['e0000000-0000-4000-8000-000000000003'];",
                  "pm.test('Semua pasien berasal dari Puskesmas Pandanaran', () => {",
                  "  pm.expect(result.total).to.eql(expectedPandanaranProfiles.length);",
                  "  pm.expect(result.data).to.have.length(expectedPandanaranProfiles.length);",
                  "  result.data.forEach((patient) => pm.expect(expectedPandanaranProfiles).to.include(patient.pregnancy_profile_id));",
                  "  pm.expect(result.data.map((patient) => patient.pregnancy_profile_id).sort()).to.eql([...expectedPandanaranProfiles].sort());",
                  "  pm.expect(result.total).to.not.eql(Number(pm.collectionVariables.get('bidan_patient_total')));",
                  "});"
