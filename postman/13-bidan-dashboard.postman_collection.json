    {
      "name": "Statistics",
      "item": [
        {
          "name": "GET /bidan/statistics",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const stats = pm.response.json().data;",
                  "pm.expect(stats).to.have.keys('total_patients', 'risk_distribution', 'overdue_checkins', 'nifas_count');",
                  "pm.expect(stats.total_patients).to.be.a('number');",
                  "pm.expect(stats.risk_distribution).to.have.keys('merah', 'kuning', 'hijau');",
                  "pm.expect(stats.overdue_checkins).to.be.a('number');",
                  "pm.expect(stats.nifas_count).to.be.a('number');",
                  "const assessed = stats.risk_distribution.merah + stats.risk_distribution.kuning + stats.risk_distribution.hijau;",
                  "pm.expect(assessed).to.be.at.most(stats.total_patients);",
                  "pm.collectionVariables.set('bidan_statistics_total', String(stats.total_patients));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
