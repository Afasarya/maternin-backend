              "raw": "{{base_url}}/bidan/patients?search=Siti",
              "host": ["{{base_url}}"],
              "path": ["bidan", "patients"],
              "query": [
                {
                  "key": "search",
                  "value": "Siti"
                }
              ]
            }
          }
        },
        {
          "name": "GET /bidan/patients — pagination",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result.limit).to.eql(2);",
                  "pm.expect(result.offset).to.eql(0);",
                  "pm.expect(result.data.length).to.be.at.most(2);",
                  "pm.expect(result.total).to.be.at.least(result.data.length);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_bidan}}",
                "type": "text"
