                  "pm.expect(brief).to.have.keys('patient_name', 'gestational_week', 'latest_risk_badge', 'vitals_summary', 'risk_factors', 'recent_symptoms', 'recommendation', 'last_visit_date');",
                  "pm.expect(brief.patient_name).to.be.a('string');",
                  "pm.expect(brief.gestational_week).to.be.a('number');",
                  "pm.expect(brief.risk_factors).to.be.an('array');",
