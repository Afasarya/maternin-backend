        {
          "name": "GET /postpartum-logs — owner paginated day ASC",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result.data).to.be.an('array');",
                  "pm.expect(result.total).to.be.a('number');",
                  "pm.expect(result.data.length).to.be.at.most(10);",
                  "for (let i = 1; i < result.data.length; i++) pm.expect(result.data[i - 1].day_number).to.be.at.most(result.data[i].day_number);"
                ]
              }
            }
