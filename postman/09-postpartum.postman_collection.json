                  "pm.expect(result.log.bleeding_level).to.eql('banyak');",
                  "pm.expect(result.log.headache_severe).to.eql(true);",
                  "pm.expect(['processing', undefined]).to.include(result.status);",
                  "if (result.evaluation) {",
