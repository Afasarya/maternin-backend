  "item": [
    {
      "name": "Create Log",
      "item": [
        {
          "name": "POST /postpartum-logs — normal check-in",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('postpartum_client_uuid', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result.log.pregnancy_profile_id).to.eql(pm.collectionVariables.get('pregnancy_profile_id'));",
                  "pm.expect(result.log.day_number).to.eql(3);",
                  "pm.expect(result.log.client_uuid).to.eql(pm.collectionVariables.get('postpartum_client_uuid'));",
                  "pm.expect(['processing', undefined]).to.include(result.status);",
                  "if (result.evaluation) {",
                  "  pm.expect(result.evaluation.red_flag_triggered).to.eql(false);",
                  "  pm.expect(result.log.red_flag_triggered).to.eql(false);",
                  "}",
                  "pm.collectionVariables.set('postpartum_log_id', result.log.id);",
                  "pm.collectionVariables.set('idempotency_log_id', result.log.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_ibu}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Request-Id",
                "value": "postman-postpartum-normal",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pregnancy_profile_id\": \"{{pregnancy_profile_id}}\",\n  \"day_number\": 3,\n  \"bleeding_level\": \"normal\",\n  \"fever\": false,\n  \"wound_condition\": \"baik\",\n  \"headache_severe\": false,\n  \"mood_flag\": \"baik\",\n  \"client_uuid\": \"{{postpartum_client_uuid}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/postpartum-logs",
              "host": ["{{base_url}}"],
              "path": ["postpartum-logs"]
            }
          }
        },
        {
          "name": "POST /postpartum-logs — idempotency replay",
          "event": [
