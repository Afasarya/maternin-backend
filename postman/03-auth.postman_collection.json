                  "if (data.access_token) pm.collectionVariables.set('token_admin', data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/register — error: phone sudah terdaftar",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Siti Duplikat\",\n  \"phone_number\": \"+6281234500301\",\n  \"password\": \"password123\",\n  \"role\": \"ibu_hamil\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status code is 409', () => pm.response.to.have.status(409));"]
              }
            }
          ]
        },
        {
          "name": "POST /auth/register — error: bidan tanpa puskesmas_id",
          "request": {
            "method": "POST",
