{
  "info": {
    "name": "03 — Auth Module",
    "description": "Task 03: Register, login, JWT, role validation, dan rate limiting. Isi puskesmas_id dengan UUID fasilitas yang sudah ada sebelum request bidan/kader dijalankan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "puskesmas_id",
      "value": "00000000-0000-4000-8000-000000000000",
      "type": "string"
    },
    {
      "key": "token_ibu",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_bidan",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_kader",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_admin",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Register",
      "item": [
        {
          "name": "POST /auth/register — ibu_hamil",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Siti Aminah\",\n  \"phone_number\": \"+6281234500301\",\n  \"password\": \"password123\",\n  \"role\": \"ibu_hamil\",\n  \"email\": \"siti@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "const data = json.data || json;",
                  "if (data.access_token) pm.collectionVariables.set('token_ibu', data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/register — bidan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Bidan Dewi\",\n  \"phone_number\": \"+6281234500302\",\n  \"password\": \"password123\",\n  \"role\": \"bidan\",\n  \"email\": \"dewi@example.com\",\n  \"puskesmas_id\": \"{{puskesmas_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Ganti collection variable puskesmas_id dengan UUID puskesmas yang sudah ada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
