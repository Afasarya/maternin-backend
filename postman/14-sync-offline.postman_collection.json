    },
    {
      "name": "Status",
      "item": [
        {
          "name": "GET /sync/status?device_uuid=...",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const status = pm.response.json().data;",
                  "pm.expect(status.device_uuid).to.eql(pm.collectionVariables.get('device_uuid'));",
                  "pm.expect(status).to.include({ total: 7, processed: 6, pending: 0, failed: 1 });",
                  "pm.expect(status.last_sync).to.be.an('object');",
                  "pm.expect(status.last_sync.status).to.eql('processed');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_kader}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sync/status?device_uuid={{device_uuid}}",
              "host": ["{{base_url}}"],
              "path": ["sync", "status"],
              "query": [
                {
                  "key": "device_uuid",
                  "value": "{{device_uuid}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Access Control",
      "item": [
        {
          "name": "POST /sync/batch — kader luar wilayah gagal per record",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 because sync_queue record is created', () => pm.response.to.have.status(201));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result).to.include({ total_received: 1, processed: 0, skipped: 0, failed: 1 });",
                  "pm.expect(result.results[0].client_uuid).to.eql(pm.collectionVariables.get('outside_region_client_uuid'));",
                  "pm.expect(result.results[0].status).to.eql('failed');",
                  "pm.expect(result.results[0].reason.toLowerCase()).to.include('akses');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
