  "item": [
    {
      "name": "Batch Sync",
      "item": [
        {
          "name": "POST /sync/batch — 2 ANC records",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = pm.variables.replaceIn('{{$guid}}');",
                  "const now = new Date();",
                  "pm.collectionVariables.set('device_uuid', `device-task-14-${runId}`);",
                  "pm.collectionVariables.set('anc_client_uuid_1', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('anc_client_uuid_2', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('mixed_anc_client_uuid', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('mixed_symptom_client_uuid', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('partial_new_client_uuid', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('invalid_payload_client_uuid', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('valid_after_invalid_client_uuid', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('outside_region_client_uuid', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('batch_created_at', now.toISOString());",
                  "pm.collectionVariables.set('mixed_created_at', new Date(now.getTime() + 60000).toISOString());",
                  "pm.collectionVariables.set('partial_created_at', new Date(now.getTime() + 120000).toISOString());",
                  "pm.collectionVariables.set('invalid_created_at', new Date(now.getTime() + 180000).toISOString());",
                  "pm.collectionVariables.set('valid_after_invalid_created_at', new Date(now.getTime() + 181000).toISOString());",
                  "pm.collectionVariables.set('outside_created_at', new Date(now.getTime() + 240000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result).to.include({ total_received: 2, processed: 2, skipped: 0, failed: 0 });",
                  "pm.expect(result.results).to.have.length(2);",
                  "pm.test('Dua ANC diproses dan memiliki server_id', () => result.results.forEach((item) => {",
                  "  pm.expect(item.status).to.eql('processed');",
                  "  pm.expect(item.server_id).to.be.a('string').and.not.empty;",
                  "}));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_kader}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Request-Id",
                "value": "postman-sync-two-anc",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_uuid\": \"{{device_uuid}}\",\n  \"records\": [\n    {\n      \"client_uuid\": \"{{anc_client_uuid_1}}\",\n      \"payload_type\": \"anc_record\",\n      \"payload\": {\n        \"pregnancy_profile_id\": \"{{pregnancy_profile_id}}\",\n        \"systolic\": 120,\n        \"diastolic\": 80,\n        \"weight_kg\": 62,\n        \"recorded_at\": \"{{batch_created_at}}\"\n      },\n      \"client_created_at\": \"{{batch_created_at}}\"\n    },\n    {\n      \"client_uuid\": \"{{anc_client_uuid_2}}\",\n      \"payload_type\": \"anc_record\",\n      \"payload\": {\n        \"pregnancy_profile_id\": \"{{pregnancy_profile_id}}\",\n        \"systolic\": 124,\n        \"diastolic\": 82,\n        \"weight_kg\": 62.4,\n        \"recorded_at\": \"{{batch_created_at}}\"\n      },\n      \"client_created_at\": \"{{batch_created_at}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/sync/batch",
              "host": ["{{base_url}}"],
              "path": ["sync", "batch"]
            }
          }
        },
        {
          "name": "POST /sync/batch — 1 ANC + 1 symptom check-in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result).to.include({ total_received: 2, processed: 2, skipped: 0, failed: 0 });",
                  "pm.expect(result.results.map((item) => item.client_uuid)).to.include.members([",
                  "  pm.collectionVariables.get('mixed_anc_client_uuid'),",
                  "  pm.collectionVariables.get('mixed_symptom_client_uuid')",
                  "]);",
                  "pm.test('Pipeline mixed menghasilkan server_id', () => result.results.forEach((item) => pm.expect(item.server_id).to.be.a('string').and.not.empty));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_kader}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Request-Id",
                "value": "postman-sync-mixed",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_uuid\": \"{{device_uuid}}\",\n  \"records\": [\n    {\n      \"client_uuid\": \"{{mixed_anc_client_uuid}}\",\n      \"payload_type\": \"anc_record\",\n      \"payload\": {\n        \"pregnancy_profile_id\": \"{{pregnancy_profile_id}}\",\n        \"systolic\": 128,\n        \"diastolic\": 84,\n        \"protein_urine\": \"negatif\",\n        \"recorded_at\": \"{{mixed_created_at}}\"\n      },\n      \"client_created_at\": \"{{mixed_created_at}}\"\n    },\n    {\n      \"client_uuid\": \"{{mixed_symptom_client_uuid}}\",\n      \"payload_type\": \"symptom_checkin\",\n      \"payload\": {\n        \"pregnancy_profile_id\": \"{{pregnancy_profile_id}}\",\n        \"checkin_type\": \"pregnancy\",\n        \"answers\": {\n          \"bengkak_kaki\": true,\n          \"sakit_kepala\": \"ringan\"\n        }\n      },\n      \"client_created_at\": \"{{mixed_created_at}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/sync/batch",
              "host": ["{{base_url}}"],
              "path": ["sync", "batch"]
            },
            "description": "Symptom check-in memakai pipeline Task 07. Bila AI Service down, check-in tetap tersimpan dan retry triage dijadwalkan."
          }
        },
        {
          "name": "POST /sync/batch — duplicate replay",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result).to.include({ total_received: 2, processed: 0, skipped: 2, failed: 0 });",
                  "pm.test('Semua replay di-skip sebagai duplicate', () => result.results.forEach((item) => {",
                  "  pm.expect(item.status).to.eql('skipped');",
                  "  pm.expect(item.reason).to.eql('duplicate');",
                  "}));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_kader}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_uuid\": \"{{device_uuid}}\",\n  \"records\": [\n    {\n      \"client_uuid\": \"{{anc_client_uuid_1}}\",\n      \"payload_type\": \"anc_record\",\n      \"payload\": {\n        \"pregnancy_profile_id\": \"{{pregnancy_profile_id}}\",\n        \"systolic\": 120,\n        \"diastolic\": 80,\n        \"weight_kg\": 62,\n        \"recorded_at\": \"{{batch_created_at}}\"\n      },\n      \"client_created_at\": \"{{batch_created_at}}\"\n    },\n    {\n      \"client_uuid\": \"{{anc_client_uuid_2}}\",\n      \"payload_type\": \"anc_record\",\n      \"payload\": {\n        \"pregnancy_profile_id\": \"{{pregnancy_profile_id}}\",\n        \"systolic\": 124,\n        \"diastolic\": 82,\n        \"weight_kg\": 62.4,\n        \"recorded_at\": \"{{batch_created_at}}\"\n      },\n      \"client_created_at\": \"{{batch_created_at}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/sync/batch",
              "host": ["{{base_url}}"],
              "path": ["sync", "batch"]
            }
          }
        },
        {
          "name": "POST /sync/batch — 1 new + 1 duplicate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result).to.include({ total_received: 2, processed: 1, skipped: 1, failed: 0 });",
                  "const duplicate = result.results.find((item) => item.client_uuid === pm.collectionVariables.get('anc_client_uuid_1'));",
                  "const inserted = result.results.find((item) => item.client_uuid === pm.collectionVariables.get('partial_new_client_uuid'));",
                  "pm.expect(duplicate).to.include({ status: 'skipped', reason: 'duplicate' });",
                  "pm.expect(inserted.status).to.eql('processed');",
                  "pm.expect(inserted.server_id).to.be.a('string').and.not.empty;"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_kader}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_uuid\": \"{{device_uuid}}\",\n  \"records\": [\n    {\n      \"client_uuid\": \"{{anc_client_uuid_1}}\",\n      \"payload_type\": \"anc_record\",\n      \"payload\": {\n        \"pregnancy_profile_id\": \"{{pregnancy_profile_id}}\",\n        \"systolic\": 120,\n        \"diastolic\": 80,\n        \"weight_kg\": 62,\n        \"recorded_at\": \"{{batch_created_at}}\"\n      },\n      \"client_created_at\": \"{{batch_created_at}}\"\n    },\n    {\n      \"client_uuid\": \"{{partial_new_client_uuid}}\",\n      \"payload_type\": \"anc_record\",\n      \"payload\": {\n        \"pregnancy_profile_id\": \"{{pregnancy_profile_id}}\",\n        \"systolic\": 126,\n        \"diastolic\": 83,\n        \"recorded_at\": \"{{partial_created_at}}\"\n      },\n      \"client_created_at\": \"{{partial_created_at}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/sync/batch",
              "host": ["{{base_url}}"],
              "path": ["sync", "batch"]
            }
          }
        },
        {
          "name": "POST /sync/batch — invalid payload isolated",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result).to.include({ total_received: 2, processed: 1, skipped: 0, failed: 1 });",
                  "const invalid = result.results.find((item) => item.client_uuid === pm.collectionVariables.get('invalid_payload_client_uuid'));",
                  "const valid = result.results.find((item) => item.client_uuid === pm.collectionVariables.get('valid_after_invalid_client_uuid'));",
                  "pm.expect(invalid.status).to.eql('failed');",
                  "pm.expect(invalid.reason).to.include('tidak valid');",
                  "pm.expect(valid.status).to.eql('processed');",
                  "pm.expect(valid.server_id).to.be.a('string').and.not.empty;"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_kader}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_uuid\": \"{{device_uuid}}\",\n  \"records\": [\n    {\n      \"client_uuid\": \"{{invalid_payload_client_uuid}}\",\n      \"payload_type\": \"anc_record\",\n      \"payload\": {\n        \"systolic\": 130,\n        \"diastolic\": 85\n      },\n      \"client_created_at\": \"{{invalid_created_at}}\"\n    },\n    {\n      \"client_uuid\": \"{{valid_after_invalid_client_uuid}}\",\n      \"payload_type\": \"anc_record\",\n      \"payload\": {\n        \"pregnancy_profile_id\": \"{{pregnancy_profile_id}}\",\n        \"systolic\": 118,\n        \"diastolic\": 78,\n        \"recorded_at\": \"{{valid_after_invalid_created_at}}\"\n      },\n      \"client_created_at\": \"{{valid_after_invalid_created_at}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/sync/batch",
              "host": ["{{base_url}}"],
              "path": ["sync", "batch"]
            },
            "description": "Record pertama sengaja kehilangan pregnancy_profile_id. Validasi subtype terjadi per record di SyncService; record kedua tetap diproses."
          }
        },
