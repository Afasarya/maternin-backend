            },
            "url": {
              "raw": "{{base_url}}/sync/batch",
              "host": ["{{base_url}}"],
              "path": ["sync", "batch"]
            },
            "description": "Kader seed Halmahera mencoba menulis profil seed Pandanaran. AncRecordsService.create() harus menolak scoping wilayah; SyncService mengisolasi kegagalan sebagai hasil per record."
          }
        },
