{
  "info": {
    "name": "12 — Notifications",
    "description": "Task 12: histori notifikasi Fonnte, pagination, filter channel/status, detail log, dan access control. Kader ditolak karena log notifikasi dapat mengungkap data klinis/intensitas risiko. Collection ini tidak mengirim WhatsApp nyata.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token_ibu",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_ibu_lain",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_bidan",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_bidan_lain",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_kader",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_admin",
      "value": "",
      "type": "string"
    },
    {
      "key": "pregnancy_profile_id",
      "value": "e0000000-0000-4000-8000-000000000001",
      "type": "string"
    },
    {
      "key": "notification_log_id",
      "value": "80000000-0000-4000-8000-000000000001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "History",
      "item": [
        {
          "name": "GET /notifications — paginated history",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().data;",
                  "pm.expect(result.data).to.be.an('array');",
                  "pm.expect(result.total).to.be.a('number');",
                  "pm.expect(result.data.length).to.be.at.most(20);",
                  "result.data.forEach((notification) => pm.expect(notification.pregnancy_profile_id).to.eql(pm.collectionVariables.get('pregnancy_profile_id')));",
                  "if (result.data.length > 0) pm.collectionVariables.set('notification_log_id', result.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_ibu}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notifications?pregnancy_profile_id={{pregnancy_profile_id}}&limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["notifications"],
              "query": [
                {
                  "key": "pregnancy_profile_id",
                  "value": "{{pregnancy_profile_id}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "GET /notifications — filter wa_patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().data;",
                  "pm.test('Hanya wa_patient sent dengan sent_at terisi', () => {",
                  "  pm.expect(result.data).to.be.an('array').and.not.empty;",
                  "  result.data.forEach((notification) => {",
                  "    pm.expect(notification.channel).to.eql('wa_patient');",
                  "    pm.expect(notification.status).to.eql('sent');",
                  "    pm.expect(notification.sent_at).to.not.eql(null);",
                  "  });",
                  "});",
                  "pm.collectionVariables.set('notification_log_id', result.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_bidan}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notifications?pregnancy_profile_id={{pregnancy_profile_id}}&channel=wa_patient&status=sent",
              "host": ["{{base_url}}"],
              "path": ["notifications"],
              "query": [
                {
                  "key": "pregnancy_profile_id",
                  "value": "{{pregnancy_profile_id}}"
                },
                {
                  "key": "channel",
                  "value": "wa_patient"
                },
                {
                  "key": "status",
                  "value": "sent"
                }
              ]
            }
          }
        },
        {
          "name": "GET /notifications — filter failed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json().data;",
                  "pm.test('Semua status failed memiliki sent_at null', () => {",
                  "  pm.expect(result.data).to.be.an('array').and.not.empty;",
                  "  result.data.forEach((notification) => {",
                  "    pm.expect(notification.status).to.eql('failed');",
                  "    pm.expect(notification.sent_at).to.eql(null);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
